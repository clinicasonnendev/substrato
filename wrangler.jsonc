{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "substrato",
  "compatibility_date": "2026-08-03",
  "main": "_worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "TENANTS",
      "id": "COLE_AQUI_O_ID_DO_NAMESPACE_KV"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
